# ── Google API ─────────────────────────────────────────────────────────────────
# Service Account email dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Private key dari service account JSON (salin seluruh nilai termasuk header/footer)
# Ganti newline literal dengan \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Google Sheets ───────────────────────────────────────────────────────────────
# ID spreadsheet dari URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# ── Google Drive ────────────────────────────────────────────────────────────────
# ID folder root di Google Drive untuk menyimpan semua asset portfolio
# Buat folder "noch-portfolio" di Drive, share ke service account email (Editor)
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id_here

# ── Admin Authentication ────────────────────────────────────────────────────────
# Username untuk login admin
ADMIN_USERNAME=admin

# Bcrypt hash dari password admin
# Generate dengan: node -e "const b=require('bcryptjs');console.log(b.hashSync('your_password',10))"
ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret untuk signing JWT (minimal 64 karakter random)
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_character_secret_here_replace_with_actual_value

# ── App ─────────────────────────────────────────────────────────────────────────
# URL aplikasi (gunakan https di production Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
